# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

node_modules/
fixtures/*

# pnpm's local package store, created here when pnpm install runs inside the
# dev container (no shared global store across container restarts)
.pnpm-store/

# local dev SQLite database (created by `connect_dev_db()` / the seed bin)
dev.db*
# e2e test database (seeded from test-fixtures/)
e2e.db*

*.internal.md

pnpm dlx tailwindcss